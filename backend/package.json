{
  "name": "backend",
  "version": "1.0.0",
  "description": "Arca API: Express, PostgreSQL (Drizzle), layered architecture",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "DEBUG=arca:* tsx watch src/server.ts",
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcrypt-ts": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.4",
    "prettier": "3.9.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
